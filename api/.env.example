# Application
QUIZ_API_ENVIRONMENT=local
QUIZ_API_LOG_LEVEL=INFO
QUIZ_API_HOST=127.0.0.1
QUIZ_API_PORT=8000
QUIZ_API_CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL (Neon or another PostgreSQL-compatible database).
# Use the async SQLAlchemy dialect. Do not commit a real connection string.
QUIZ_API_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DATABASE?ssl=require

# Local Redis from docker compose.
QUIZ_API_REDIS_URL=redis://localhost:6379/0

# Replace every placeholder below with a unique secret before running the API.
QUIZ_API_JWT_SIGNING_KEY=replace-with-a-long-random-secret
QUIZ_API_HOST_DEMO_TOKEN=replace-with-a-long-random-host-token

# Authentication and real-time delivery.
QUIZ_API_PARTICIPANT_TOKEN_TTL_SECONDS=14400
QUIZ_API_STREAM_TOKEN_TTL_SECONDS=300
QUIZ_API_LEADERBOARD_TICK_MS=250
QUIZ_API_FULL_LEADERBOARD_LIMIT=500
QUIZ_API_COMPACT_LEADERBOARD_LIMIT=50
